# Base URL of the FastAPI backend.
#
# Unset (default): the UI calls the same origin the page is served from, which
# is what you want when nginx proxies /search and /health to the API on
# the same port the app is served on.
#
# For local dev (next dev on :3000, API on :8001), set:
# NEXT_PUBLIC_API_BASE=http://localhost:8001
NEXT_PUBLIC_API_BASE=http://localhost:8001

# Comma-separated hostnames the frontend will forward auth tokens to. Requests
# to any other host are sent without credentials. Leave unset to allow only
# the same origin (safest default for production).
# Example (local dev with API on a different port):
# NEXT_PUBLIC_TRUSTED_API_HOSTS=localhost
# NEXT_PUBLIC_TRUSTED_API_HOSTS=

# TTL in milliseconds for the cached /api/auth/me response (current-user
# profile). Avoids a round-trip on every page render. Default: 60000 (1 min).
# NEXT_PUBLIC_ME_CACHE_TTL_MS=60000