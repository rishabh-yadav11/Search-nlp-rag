# Python
__pycache__/
*.py[cod]
venv/
.venv/

# Environment
.env
backend/.env
# Rotated credential backups (setup.sh writes .env.bak.<ts>) hold live secrets
# and are no less sensitive than the file they came from.
.env.bak*
backend/.env.bak*

# Data (fetched articles, index checkpoints, generated vocab)
backend/data/
backend/backups/
qdrant_data/
logs/

# Qdrant runtime artifacts
qdrant_config.yaml
.qdrant-initialized

# OS
.DS_Store

# Runtime
.pid/
AGENTS.md
*.log
REVIEWER.md

# local git worktrees
swt/
wt/

# coverage.py artifact from the (now removed) test suite
backend/.coverage

# Scratch SQLite files written by the backend test suite (see
# backend/tests/conftest.py); regenerated fresh on every session.
backend/tests/.testdata/

# Playwright E2E (e2e/) — node install + run artifacts
e2e/node_modules/
e2e/playwright-report/
e2e/test-results/
