# MySQL source database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=vccircle
MYSQL_TABLE=articles

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=vccircle_articles

# Redis cache (shared across gunicorn workers)
REDIS_URL=redis://localhost:6379/0

# Embedding model
EMBED_MODEL=BAAI/bge-base-en-v1.5
EMBED_BATCH_SIZE=256
EMBED_DEVICE=cpu
# Indexed text limits: the dense vector gets title+facets+summary only
# (kept short for fast CPU builds); the sparse/lexical vector gets the full
# text with body so body keywords stay searchable.
EMBED_DENSE_CHAR_LIMIT=1500
EMBED_CHAR_LIMIT=6000
BODY_CHAR_LIMIT=6000
# In-flight encode batches (depth of the encode|upsert pipeline). Each batch
# near max-token length uses ~1-2GB during encode, so depth * batch must fit
# in RAM. Keep small on CPU.
INDEXER_WORKERS=2
# Sparse (BM25) embedding model — must match at index time
SPARSE_MODEL=Qdrant/bm25
# Cross-encoder reranker applied to RRF candidates before top_k is kept
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=16

# LLM for answer synthesis (Groq, OpenAI-compatible API)
GROQ_API_KEY=your_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Search defaults
TOP_K=8
ASK_MIN_SCORE=0.2
CACHE_TTL_SECONDS=120
CACHE_MAX_SIZE=1000
# Recency-tempered ranking: score *= 1 - STRENGTH*(1 - exp(-age_days/DECAY))
RECENCY_STRENGTH=0.25
RECENCY_DECAY_DAYS=90

# Analytics (aggregates live in Redis DB 1 so a cache FLUSHDB on DB 0 doesn't
# wipe them). Set a view token to protect /analytics/summary.
ANALYTICS_REDIS_DB=1
ANALYTICS_VIEW_TOKEN=
