# MySQL source database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=vccircle
MYSQL_TABLE=articles

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=vccircle_articles

# Redis cache (shared across gunicorn workers)
REDIS_URL=redis://localhost:6379/0

# Embedding model
EMBED_MODEL=BAAI/bge-base-en-v1.5
EMBED_BATCH_SIZE=256
EMBED_DEVICE=cpu
# CPU threads per worker for torch/onnxruntime inference (kept small so 4
# gunicorn workers don't oversubscribe the box's cores).
TORCH_THREADS=2
# Indexed text limits: the dense vector gets title+facets+summary only
# (kept short for fast CPU builds); the sparse/lexical vector gets the full
# text with body so body keywords stay searchable. The body caps default to
# 50000, covering the whole corpus; CHAT_BODY_CHAR_LIMIT caps the per-source
# body excerpt fed to the chat LLM (lower it to cut prompt tokens/cost).
EMBED_DENSE_CHAR_LIMIT=1500
EMBED_CHAR_LIMIT=50000
BODY_CHAR_LIMIT=50000
CHAT_BODY_CHAR_LIMIT=50000
# In-flight encode batches (depth of the encode|upsert pipeline). Each batch
# near max-token length uses ~1-2GB during encode, so depth * batch must fit
# in RAM. Keep small on CPU.
INDEXER_WORKERS=2
# Sparse (BM25) embedding model — must match at index time
SPARSE_MODEL=Qdrant/bm25
# Cross-encoder reranker applied to RRF candidates before top_k is kept.
# 12 candidates trims CPU rerank latency vs 16 with no measurable top-8 loss.
# Values outside [5, 50] are clamped to the nearest bound and a warning is
# logged (they are NOT passed through): the high end serialises every other
# inference in the process behind one cross-encoder batch, the low end leaves
# too few candidates to rank at all.
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=12
# Reranker backend: 'torch' (sentence-transformers CrossEncoder) is the only
# backend. The ONNX backend ('onnx', via optimum) is not installable alongside
# the pinned transformers 5.x (CVE fixes): optimum-onnx requires <4.58, so that
# code path was removed. Any value other than 'torch' warns and uses torch.
RERANK_BACKEND=torch
# Inert: dir that held the exported ONNX cross-encoder cache. Nothing reads it
# now; kept as a documented placeholder.
RERANK_ONNX_DIR=data/reranker_onnx

# LLM for answer synthesis (Google Gemini via OpenAI-compatible endpoint).
# Set GEMINI_API_KEY (you generate one at https://aistudio.google.com/apikey).
# The value below is a PLACEHOLDER and is rejected on purpose: with it left in
# place, chat answers 100% of questions with the canned fallback, and readiness
# reports checks.llm.reason="placeholder" and answers 503, so `setup.sh` refuses
# to call the deploy done and deploy/healthcheck.sh alerts. Startup logs the same
# fault by name. Any other filler ("your-api-key", "changeme", "TODO", ...) is
# rejected the same way; a real Google key starts with "AIza".
GEMINI_API_KEY=your_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.1-flash-lite
# Answer model. Kept SEPARATE from GEMINI_MODEL so the eval judge (which reads
# GEMINI_MODEL) stays fixed while you A/B different answer models. Falls back to
# GEMINI_MODEL when unset. Example candidates: gemini-3-flash, gemini-2.5-flash.
LLM_MODEL=gemini-3.1-flash-lite
# Sampling temperature for answer synthesis. 0.0 is deterministic and minimizes
# hallucination on thin context; raise only for more creative variation.
LLM_TEMPERATURE=0.0
# USD per 1M tokens for cost tracking (defaults = Gemini 3.1 Flash Lite)
LLM_PRICE_INPUT_PER_1M=0.25
LLM_PRICE_OUTPUT_PER_1M=1.50
# Daily LLM spend cap in USD. Chat fails closed (refuses LLM calls) once today's
# cumulative spend reaches this value. 0 is a deliberate opt-out for deployments
# that meter spend elsewhere; leaving it unset is not (the default is 5.0).
LLM_DAILY_BUDGET_USD=5.0
# Per-billed-call hold taken against the cap BEFORE the call runs, so concurrent
# turns contend for the same budget instead of each reading a stale counter.
LLM_CALL_RESERVE_USD=0.05
# Display currency conversion (cost is shown in INR)
INR_PER_USD=95.60

# Search defaults
TOP_K=8
ASK_MIN_SCORE=0.2
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE=1000
# Byte budget for the in-process fallback cache used when Redis is down. Bounds
# memory by bytes as well as by entry count, so large embedding-vector entries
# cannot evict all the small search-result entries.
CACHE_MAX_BYTES=33554432
# TTL for cached query (dense+sparse) vectors, keyed by embedding model so a
# model change invalidates them automatically.
VECTOR_CACHE_TTL_SECONDS=86400
# Readiness probe: cache the /ready + /readyz result for this long, and bound
# each dependency probe with its own timeout (probes run concurrently).
READY_CACHE_TTL_SECONDS=5
READY_DEP_TIMEOUT_SECONDS=2.0
# Query-string typo correction (symspellpy over a corpus vocab + entities).
# Generate the vocab with: ./venv/bin/python scripts/build_query_vocab.py
# When QUERY_FIX_VOCAB_PATH is missing, correction is a silent no-op.
# ENABLE_* values: 1/true/yes/on and 0/false/no/off, any case, surrounding
# spaces ignored. Set but BLANK reads as OFF, not as "unset" -- to fall back
# to the default, delete the line. Any other value is a typo: it logs a
# warning and uses the default rather than failing the boot.
ENABLE_QUERY_FIX=true
QUERY_FIX_VOCAB_PATH=data/query_vocab.json.gz
QUERY_FIX_MAX_EDIT=2
QUERY_FIX_MIN_COUNT=5
QUERY_FIX_MIN_TOKEN_LEN=3
# Recency-tempered ranking: score *= 1 - STRENGTH*(1 - exp(-age_days/DECAY))
RECENCY_STRENGTH=0.25
RECENCY_DECAY_DAYS=90
# Stronger recency weighting when the query itself asks for fresh news
# ('latest'/'recent'/'fresh'); hard windows like 'this week' are filtered, not
# boosted. Defaults are what the code hardcoded before these were knobs.
RECENCY_BOOST_STRENGTH=0.85
RECENCY_BOOST_DECAY_DAYS=30.0

# Answerability: a hit counts as strong above WEAK_RESULT_SCORE, and a result
# list is reported as weakly answered below WEAK_RESULT_MIN_STRONG of them
# (capped at the list length, floored at 1). This moves the /search weak note;
# chat's fallback only ever sees a single source, where the count is always 1.
WEAK_RESULT_SCORE=0.3
WEAK_RESULT_MIN_STRONG=3
# Relevance floor given to date-only fallback fillers (temporal queries whose
# lexical signal is too weak to fill the window). Independent of ASK_MIN_SCORE,
# so keep it at or above that gate or the fillers get dropped before the model
# sees them.
DATE_FILLER_SCORE=0.2

# Result diversity: greedy MMR over reranked results to avoid near-duplicate
# headlines in the top-k. LAMBDA near 1 favours pure relevance.
# Enable spellings: see the note above ENABLE_QUERY_FIX.
ENABLE_DIVERSITY=true
DIVERSITY_LAMBDA=0.7
DIVERSITY_SIM_THRESHOLD=0.4
# Click-driven learning: boosts results users actually open for a query. Inert
# until a query accumulates enough clicks (min counts + share thresholds).
# Enable spellings: see the note above ENABLE_QUERY_FIX.
ENABLE_CLICK_BOOST=true
CLICK_BOOST_MIN_CLICKS=5
CLICK_BOOST_MIN_ARTICLE_CLICKS=3
CLICK_BOOST_MIN_SHARE=0.3
CLICK_BOOST_MULT=1.3

# Analytics (aggregates live in Redis DB 1 so a cache FLUSHDB on DB 0 doesn't
# wipe them). Read endpoints are gated by the auth layer (admin role).
ANALYTICS_REDIS_DB=1

# Auth (token + RBAC). Public signup/login; role-based access control on top.
# Opaque bearer tokens, hashed at rest, AUTH_TOKEN_TTL_DAYS expiry, revocable.
AUTH_DB_PATH=data/auth.db
# Redis DB for the auth rate-limit counters, pinned so they cannot inherit the
# db segment of REDIS_URL. This used to follow the URL, which put them in DB 0
# — the query cache a deploy FLUSHDBs — so a flush silently reset every bucket.
# Keep this off DB 0.
AUTH_RATE_LIMIT_REDIS_DB=3
AUTH_TOKEN_TTL_DAYS=7
# Public signups always get the 'user' role; there is intentionally no env
# knob for it. Promote an account with an authenticated admin session
# (PATCH /api/auth/users/{id}), never via configuration.
# Optional machine credential for internal scripts: the X-Service-Token header
# matching this value. It is a SEED, not a standing grant -- the first request
# presenting it creates a stored credential that can only exercise
# AUTH_SERVICE_TOKEN_SCOPE, and from then on that record is the only authority
# on its life.
#
# OPERATIONAL CONSEQUENCE: the seeded token stops working
# AUTH_SERVICE_TOKEN_MAX_AGE_SECONDS after it is first seeded, and a restart
# does NOT revive it. To keep a long-running machine client working, rotate it:
# change the value here and restart (a different value seeds a different
# record), or mint one with POST /api/auth/service-tokens and put that in the
# client's environment. Revoke with POST /api/auth/service-tokens/revoke, which
# takes {"token": "..."} to retire exactly one and {} for all of them.
# The plaintext is never stored; only its SHA-256 is.
AUTH_SERVICE_TOKEN=
# Lifetime of a service token, in seconds. A value of 0 or less falls back to
# the 86400s default rather than meaning "never expires" -- there is
# deliberately no way to configure an eternal machine admin credential.
AUTH_SERVICE_TOKEN_MAX_AGE_SECONDS=86400
# Permissions a service token may exercise (comma separated). Defaults to
# chat:use, the only permission the internal eval scripts need, rather than
# every permission an admin holds. Unknown names are ignored.
AUTH_SERVICE_TOKEN_SCOPE=chat:use
# Bootstrap admin: created once at startup if no account with this email
# exists. An existing account's password is never overwritten. Both values are
# EMPTY by default so a fresh deploy does not bootstrap a live admin; set them
# explicitly to enable the bootstrap admin.
#
# The password policy applies to these values, and a value that fails it is
# REFUSED rather than provisioned: no admin is created, an ERROR naming the
# failing check is logged, and startup continues without one -- so a fresh deploy
# can come up healthy on /health with no admin account at all. A malformed
# address (including a dotless one such as admin@localhost) will be refused.
# Only the first 72 bytes of the password ever authenticate (bcrypt truncates
# there), so anything beyond byte 72 is not part of the credential. The minimum
# length is counted in CHARACTERS over that prefix (as everywhere else in the
# auth policy), while the letter+digit rule is judged on the whole value.
AUTH_ADMIN_EMAIL=
AUTH_ADMIN_PASSWORD=
# Auth input validation limits
AUTH_PASSWORD_MIN_LEN=8
AUTH_MAX_EMAIL_LEN=254
AUTH_MAX_NAME_LEN=60
# Rate limits on signup/login (0 disables an individual limit). The per-IP
# limits are counted in Redis; the per-account one is counted in addition to
# them so rotating source addresses cannot hide an attack aimed at one account.
#
# AUTH_LOGIN_RATE_PER_ACCOUNT_PER_MIN counts FAILED logins only, and is applied
# AFTER the password check. A correct password is never counted, never gated
# and never rate-limited, so the limit cannot be turned into a denial of
# service against a known account (an anonymous caller sending N wrong
# passwords from rotating addresses would otherwise lock the owner out
# indefinitely).
#
# IMPORTANT -- what this knob is NOT. It caps the RATE of attempts aimed at one
# account and gives a per-account signal the per-IP limit cannot. It does NOT
# bound attacker COST: the check runs after the bcrypt verify, so being
# refused is free to the caller (an over-budget request costs within ~1% of an
# under-budget one). AUTH_LOGIN_RATE_PER_MIN is the control that bounds
# attacker cost. Do not size this one as a DoS control.
#
# When the limiter's Redis is unreachable these limits DO NOT disappear: the
# auth endpoints fall back to a bounded in-process limiter with the same
# numbers, so a Redis outage is degraded-to-single-process-limiting rather
# than unlimited. (The public search surface below answers 503 instead.)
AUTH_SIGNUP_RATE_PER_MIN=5
AUTH_LOGIN_RATE_PER_MIN=10
AUTH_LOGIN_RATE_PER_ACCOUNT_PER_MIN=20
AUTH_RATE_WINDOW_SECONDS=60
# Cap on simultaneously active (unexpired) tokens per user. Every login mints
# one and only EXPIRED rows are purged, so without this the auth_tokens table
# grows with the number of logins rather than the number of users. Logging in
# past the cap REVOKES the oldest ones, so an evicted token stops working
# immediately. 0 disables the cap.
AUTH_MAX_ACTIVE_TOKENS_PER_USER=10
# Redis-backed per-IP rate limits on the public search surface (0 disables one).
# These FAIL CLOSED with 503 when Redis is unreachable, since an unrated
# /search, /facets or /analytics/click is the scraping/abuse surface itself.
# /ready is the one exception: it fails OPEN, because a 503 there would pull a
# healthy node out of rotation over a dependency it does not need to be ready.
PUBLIC_SEARCH_RATE_PER_MIN=60
PUBLIC_FACETS_RATE_PER_MIN=60
PUBLIC_CLICK_RATE_PER_MIN=120
PUBLIC_INTERACTION_RATE_PER_MIN=60
# POST /recommend/interaction is reachable by any signed-up account and mints
# Redis keys per call, so it is limited on BOTH axes: per client IP above and
# per account here. A per-IP bucket alone cannot bound one account behind a
# shared NAT/proxy address, which is the shape a deliberate flood takes.
INTERACTION_USER_RATE_PER_MIN=60
# /ready is polled by load balancers ~1/s and a 429 pulls the node from
# rotation, so its default sits an order of magnitude above a 1 Hz prober.
PUBLIC_READY_RATE_PER_MIN=600
PUBLIC_RATE_WINDOW_SECONDS=60

# CORS: comma-separated allowed origins. Production serves the API and frontend
# same-origin through nginx, so this only matters for cross-origin dev clients.
CORS_ORIGINS=http://localhost:3000,http://localhost:8001

# ALLOWED_HOSTS: comma-separated hostnames the API answers to. A request whose
# Host is not on this list is rejected with 400 (TrustedHostMiddleware), so a
# wrong value here takes the whole site down. Leave unset to derive the list from
# CORS_ORIGINS, this box's own hostname and addresses (including its
# default-route address, i.e. the one a public client is reaching), and
# localhost/127.0.0.1/testserver — enough for local dev, the test client and a
# site reached by IP or by the box's own name. Set it explicitly when the API is
# reachable under a name none of those cover, e.g. a separately registered public
# domain. A bare "*" is rejected — it would disable the check. Ports are ignored
# (the Host header is compared without its port). The effective list is logged
# at startup.
ALLOWED_HOSTS=

# Chat history (SQLite on the host — survives restarts). Conversations idle
# for CHAT_RETENTION_DAYS are purged by a daily in-process cleanup task.
#
# Data paths (CHAT_DB_PATH, AUTH_DB_PATH, QUERY_FIX_VOCAB_PATH,
# RERANK_ONNX_DIR) are resolved to an ABSOLUTE path at startup: a relative
# value resolves against this backend directory, never against the process
# working directory, so launching the app from elsewhere cannot open a
# different (empty) database. The first three are logged at boot, and the app
# refuses to start if one cannot be created or written rather than silently
# coming up on an empty database. RERANK_ONNX_DIR is resolved but inert --
# nothing reads it, so it is neither logged nor required to exist.
CHAT_DB_PATH=data/chat.db
CHAT_RETENTION_DAYS=180
CHAT_MAX_HISTORY_TURNS=10
# Total characters of conversation history sent to the LLM. Long histories are
# both the most expensive turns and the least likely to need the oldest turns.
CHAT_MAX_HISTORY_CHARS=24000
CHAT_PURGE_INTERVAL_SECONDS=86400
# Messages returned by GET /api/chat/sessions/{id}. The read returns the MOST
# RECENT N messages in chronological order and sets "truncated": true plus
# "total_messages" when older ones were dropped, so the UI can say so. This caps
# the rendered thread, not the prompt: the prompt stays bounded by
# CHAT_MAX_HISTORY_TURNS/CHAT_MAX_HISTORY_CHARS/CHAT_HISTORY_CHAR_LIMIT above,
# which is deliberately tighter — you can read further back than the model is
# given context for. Stored history itself is not trimmed; it is only
# CHAT_RETENTION_DAYS that eventually purges a session.
CHAT_SESSION_MESSAGE_LIMIT=200
# Sources returned per message on that read. CHAT_MAX_SOURCES below caps what
# is generated; this caps what is serialized back per message.
CHAT_MESSAGE_SOURCE_LIMIT=20


# LLM call reliability (see app/llm.py)
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF=1.0

# Chat prompt sizing: total body budget across all sources; per-source cap is
# CHAT_BODY_CHAR_LIMIT (above). CHAT_MAX_SOURCES caps how many sources the LLM
# sees even when top_k is higher; 400000 = 8 sources x 50K bodies.
CHAT_TOTAL_BODY_CHARS=400000
CHAT_MAX_SOURCES=20
# Total characters of prior conversation replayed into the chat prompt, spent
# newest turns first. CHAT_MAX_HISTORY_TURNS bounds the turn COUNT only, and a
# replayed turn is untrusted text the model reads as data, so the replay is also
# capped by size. Anything older than the budget is dropped from the prompt.
CHAT_HISTORY_CHAR_LIMIT=12000

# Retrieval-quality toggles (all default on)
# ENABLE_* values: 1/true/yes/on and 0/false/no/off, any case, surrounding
# spaces ignored. Set but BLANK reads as OFF, not as "unset" -- to fall back
# to the default, delete the line. Any other value is a typo: it logs a
# warning and uses the default rather than failing the boot.
ENABLE_QUERY_EXPANSION=true
ENABLE_ENTITY_BOOST=true
ENABLE_WEAK_FALLBACK=true

# Body-rescue: re-score weak candidates against the densest body region to
# surface deep-body matches (historical retrospectives, mid-article facts).
# Only runs when the top reranked score is below BODY_RESCUE_THRESHOLD.
ENABLE_BODY_RESCUE=true
BODY_RESCUE_WINDOW=1500
BODY_RESCUE_STEP=500

# Body-rescue cost bounds. WINDOW is clamped to [200, 8000] and STEP to
# [1, 1500]: a 0 step raises ValueError inside range() and 500s the chat turn,
# and a tiny step re-scans the whole body (~116ms per 50K body at step=1 vs
# ~0.25ms at 500). The rescue is ON by default on purpose — it is what keeps
# deep-body matches past the relevance gate — so the second cross-encoder pass
# is capped instead of the feature being switched off.
BODY_RESCUE_MAX_CANDIDATES=10

# Max characters accepted for the /search `q` parameter (clamped to
# [32, 4000]); longer queries are rejected with 422 instead of being encoded,
# regexed and used as a cache key unbounded. Overlaps issue #241.
SEARCH_QUERY_MAX_CHARS=512

# Bounds on stored query strings (shared by the /analytics/click beacon and
# /search top-query tracking): cap the stored query length and TTL the keys so
# Redis can't grow without limit.
CLICK_QUERY_MAX_LEN=256
CLICK_QUERY_TTL_SECONDS=604800
# Daily LLM cost counter TTL (kept past the day so the budget survives brief
# outages; auto-expires instead of accumulating).
COST_DAY_TTL_SECONDS=604800
# Lifetime of an unsettled per-call spend hold. A turn that reserves and then
# crashes never settles, so after this long its hold is swept and CHARGED to the
# day's spend at the amount it reserved: a crashed billed call stays billed and
# the budget is not handed back. The hold leaves the holds table at the same
# time, so one crash cannot starve the cap until the day key rolls over.
COST_RESERVATION_TTL_SECONDS=900

# Auth + public rate limiting key on the client IP taken from X-Forwarded-For.
# 'auto' (the default) trusts that header only when the socket peer is
# loopback, i.e. a proxy on this host -- which the nginx config in setup.sh is,
# since it forwards from 127.0.0.1. That yields per-client-IP limits on the
# reference deploy with no .env edit, and still ignores the header for a client
# connecting straight to the API port, so it cannot forge one to escape its own
# bucket. Set true/false to force the behaviour regardless of peer (true when
# the proxy is on another host, false for local/direct-only access).
AUTH_TRUST_X_FORWARDED_FOR=auto
# Background interval for purging expired token rows from the auth DB (0 disables).
AUTH_TOKEN_PURGE_INTERVAL_SECONDS=3600

# Recommendations engine
# Enable spellings: see the note above ENABLE_QUERY_EXPANSION.
ENABLE_RECOMMENDATIONS=true
RECOMMEND_SIMILARITY_WEIGHT=0.4
RECOMMEND_CATEGORY_WEIGHT=0.3
RECOMMEND_RECENCY_WEIGHT=0.2
RECOMMEND_POPULARITY_WEIGHT=0.1
USER_INTERACTION_TTL_DAYS=90
# Max DISTINCT articles one account may record an interaction with (0 disables).
# Each distinct id mints an article:interactions:{id} hash plus a
# user:interaction_detail:{user_id}:{id} key, both held for the TTL above, so
# without this cap any signed-up account could grow the profile keyspace
# without bound. Re-interacting with an article already seen is always allowed.
USER_MAX_DISTINCT_INTERACTIONS=500
RECOMMEND_DEFAULT_LIMIT=10
# Candidate pool behind the personalized recommendation legs and the cold-start
# fallback (wider than the page size above; the vector leg runs one query per
# recent interaction). /recommend/similar and the trending feeds keep their own
# fixed widths.
RECOMMEND_CANDIDATES_LIMIT=50
# Redis DB used for user profiles (cache=0, analytics=1, profiles=2)
USER_PROFILE_REDIS_DB=2
TRENDING_VELOCITY_WINDOW_DAYS=7

# Level for the app's own loggers: CRITICAL, ERROR, WARNING, INFO (default) or
# DEBUG. Without it the API inherits uvicorn's root level (WARNING) with no
# handler, so every logger.info line is dropped. Only the app's loggers take
# this level -- the root logger stays at WARNING, so third-party INFO output
# (httpx/openai request lines) is not switched on in production. An
# unrecognised value falls back to INFO and logs a warning.
LOG_LEVEL=INFO
